{
  "version": 1,
  "run": {
    "entrypoint": "scripts/i2c_probe.py",
    "actions": {
      "list-buses": {
        "description": "List available I2C buses on the host (read-only, no hardware access needed)",
        "effect": "read",
        "output": "json",
        "argv": [
          "--list-buses",
          "--json"
        ],
        "params": {}
      },
      "scan": {
        "description": "Scan an I2C bus for responding device addresses (read-only probe)",
        "effect": "execute",
        "output": "json",
        "argv": [
          "--bus",
          "{bus}",
          "--range",
          "{range}",
          "--repeat",
          "{repeat}",
          "--json"
        ],
        "params": {
          "bus": {
            "type": "string",
            "max": 64,
            "required": true
          },
          "range": {
            "type": "string",
            "max": 32,
            "default": "0x08-0x77"
          },
          "repeat": {
            "type": "number",
            "min": 1,
            "max": 10,
            "default": 1
          }
        }
      }
    }
  }
}

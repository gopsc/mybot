# 所念皆星河——Speaker 声乐音调示例（简谱转录，按 1=C）
#
# 与 music.mt / xiaye.mt 同款形式：一行一音，note 列经 $(别名) 给音名，
# delay 列给时值，.mt 的时间轴就是音序器。转换口径：
#   * 唱名 ↔ 音名：1=c 2=d 3=e 5=g 6=a 7=b（本曲无 4，fa 备而未用）
#   * 八度：裸数字 = 第 4 八度；1̇→c5、2̇→d5 高八度；·5→g3 低八度
#   * 原谱「6·5」按「6 ·5」认：裸 6 = a4，后随低音 ·5 = g3
#     （与「1 6 ·5 -」同型下降句）
#   * 节奏：原谱未标时值，按均匀律一拍 350ms；「-」各延长一拍：
#     6- 记 700ms、6- - 记 1050ms、1- - - 记 1400ms；小节线只入注释
#   * wave 列的 '-'：首行不投递（落到结构脚本缺省 sine），其后继承上一行
#     ——本曲通篇正弦、无休止符
#   * 尾声「渐弱」：volume 是结构列，.mt 不可逐行覆盖（param_override 防线），
#     故按结构脚本恒定音量播放；要真渐弱，可另建低音量 Speaker 实例承接尾声行
# 段落：前奏 → A 段 → B 段（副歌）→ 尾声；全曲约 58 秒
# 换速：整体按比例改 delay 即可（如慢一档 350→450）

@Alias
name   alias;
do     c;       # 1
re     d;       # 2
mi     e;       # 3
fa     f;       # 4（本曲未用，留作模板）
sol    g;       # 5
la     a;       # 6
si     b;       # 7
doh    c5;      # 1̇（高八度 do）
reh    d5;      # 2̇（高八度 re）
sollo  g3;      # ·5（低八度 sol）
sin    sine;
rest   silence;
@

@Action
spk0.wave  spk0.note  spk0.delay;

# ---------- 前奏 ----------
 -         $(la)        350;   # 6
 -         $(si)        350;   # 7
 -         $(doh)       350;   # 1̇
 -         $(si)        350;   # 7
 -         $(la)        350;   # 6
 -         $(sol)       350;   # 5
 -         $(mi)        350;   # 3
 -         $(sol)       350;   # 5 |
 -         $(la)        350;   # 6
 -         $(si)        350;   # 7
 -         $(doh)       350;   # 1̇
 -         $(si)        350;   # 7
 -         $(la)        350;   # 6
 -         $(sol)       350;   # 5
 -         $(la)        700;   # 6 - |
 -         $(la)        350;   # 6
 -         $(si)        350;   # 7
 -         $(doh)       350;   # 1̇
 -         $(reh)       350;   # 2̇
 -         $(doh)       350;   # 1̇
 -         $(si)        350;   # 7
 -         $(la)        350;   # 6
 -         $(sol)       350;   # 5 |
 -         $(la)        350;   # 6
 -         $(sol)       350;   # 5
 -         $(mi)        350;   # 3
 -         $(sol)       350;   # 5
 -         $(la)       1050;   # 6 - - |

# ---------- A 段 ----------
 -         $(mi)        350;   # 3
 -         $(sol)       350;   # 5
 -         $(la)        350;   # 6
 -         $(doh)       350;   # 1̇
 -         $(si)        350;   # 7
 -         $(la)        350;   # 6

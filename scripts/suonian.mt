 -         $(mi)        350;   # 3
 -         $(sol)       350;   # 5
 -         $(la)        350;   # 6
 -         $(doh)       350;   # 1̇
 -         $(si)        350;   # 7
 -         $(la)        350;   # 6
 -         $(sol)       350;   # 5 |
 -         $(la)        350;   # 6
 -         $(sol)       350;   # 5
 -         $(mi)        350;   # 3
 -         $(sol)       350;   # 5
 -         $(re)        700;   # 2 - |
 -         $(mi)        350;   # 3
 -         $(sol)       350;   # 5
 -         $(la)        350;   # 6
 -         $(doh)       350;   # 1̇

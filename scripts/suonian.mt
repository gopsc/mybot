# ---------- 尾声（渐弱，恒定音量近似） ----------
 -         $(la)        350;   # 6
 -         $(si)        350;   # 7
 -         $(doh)       350;   # 1̇
 -         $(si)        350;   # 7
 -         $(la)        350;   # 6

# 夏野与暗恋——Speaker 声乐音调示例（简谱转录，按 1=C）
#
# 与 music.mt 同款形式：一行一音，note 列经 $(别名) 给音名，delay 列给时值，
# .mt 的时间轴就是音序器。转换口径：
#   * 唱名 ↔ 音名：1=c 2=d 3=e 5=g 6=a 7=b（本曲简谱无 4，fa 备而未用）
#   * 八度：裸数字 = 第 4 八度（中央C八度）；1˙→c5、2˙→d5 高八度；·5→g3 低八度
#   * 节奏：原谱未标时值，按均匀律一拍 350ms（与 music.mt 同速）；
#     「-」= 延长一拍（2- 记 700ms；「1 - -」三拍记 1050ms）；小节线只入注释
#   * 数据格只认数值，音名/wave 文本一律经 $(别名) 间接（MIDI 号也可直写）
#   * wave 列的 '-'：首行不投递（落到结构脚本缺省 sine），其后继承上一行
#     ——本曲通篇正弦、无休止符，rest/sin 备而未用
# 段落：前奏 → A 段 → A 段（整段重复）→ 副歌 → 尾声；全曲约 70 秒
# 换速：整体按比例改 delay 即可（如慢一档 350→450）

@Alias
name   alias;
do     c;       # 1
re     d;       # 2
mi     e;       # 3
fa     f;       # 4（本曲未用，留作模板）
sol    g;       # 5
la     a;       # 6
si     b;       # 7
doh    c5;      # 1˙（高八度 do）
reh    d5;      # 2˙（高八度 re）
sollo  g3;      # ·5（低八度 sol）
sin    sine;
rest   silence;
@

@Action
spk0.wave  spk0.note  spk0.delay;

# ---------- 前奏 ----------
 -         $(mi)        350;   # 3
 -         $(sol)       350;   # 5
 -         $(la)        350;   # 6
 -         $(sol)       350;   # 5
 -         $(mi)        350;   # 3
 -         $(re)        350;   # 2
 -         $(do)        350;   # 1 |
 -         $(re)        350;   # 2
 -         $(mi)        350;   # 3
 -         $(sol)       350;   # 5
 -         $(mi)        350;   # 3
 -         $(re)        700;   # 2 - |
 -         $(mi)        350;   # 3
 -         $(sol)       350;   # 5
 -         $(la)        350;   # 6
 -         $(sol)       350;   # 5
 -         $(mi)        350;   # 3
 -         $(re)        350;   # 2
 -         $(do)        350;   # 1 |
 -         $(re)        350;   # 2
 -         $(do)        350;   # 1
 -         $(la)        350;   # 6
 -         $(sollo)     700;   # ·5 - |


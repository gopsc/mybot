# 知足——Speaker 声乐音调示例（简谱转录，按 1=C）
#
# 与 music.mt / xiaye.mt / suonian.mt 同款形式：一行一音，note 列经 $(别名)
# 给音名，delay 列给时值，.mt 的时间轴就是音序器。转换口径：
#   * 唱名 ↔ 音名：1=c 2=d 3=e 4=f 5=g 6=a 7=b（本曲 4 首次登场）
#   * 八度：裸数字 = 第 4 八度；1̇→c5、2̇→d5、3̇→e5 高八度
#   * 「7」的八度判断（唯一需试听把关点）：
#       - 主歌/桥段「1 1 7 1」的 7 按**低音 B3** 认——纯文本简谱丢了低音点；
#         按 B4 认会出现大七度跳进再跳回，与原曲的下邻音绕行不符
#       - 副歌「7 7 1̇ 2̇ 3̇」的 7 按裸 **B4**（邻 1̇ 上行才顺）
#   * 节奏：原谱未标时值，按均匀律一拍 350ms；「-」各延长一拍：
#     5- 记 700ms、1- - 记 1050ms；小节线只入注释
#   * wave 列的 '-'：首行不投递（落到结构脚本缺省 sine），其后继承上一行
#     ——本曲通篇正弦、无休止符
# 段落：前奏 → 主歌 1 → 主歌 2 → 副歌 → 桥段 → 尾声；全曲约 81 秒
# 换速：整体按比例改 delay 即可（如慢一档 350→450）

@Alias
name   alias;
do     c;       # 1
re     d;       # 2
mi     e;       # 3
fa     f;       # 4
sol    g;       # 5
la     a;       # 6
si     b;       # 7（裸 = B4）
doh    c5;      # 1̇（高八度 do）
reh    d5;      # 2̇（高八度 re）
mih    e5;      # 3̇（高八度 mi）
sillo  g3;      # ·5（低八度 sol，本曲未用，留作模板）
silo   b3;      # 7̣（低八度 si，主歌/桥段用）
sin    sine;
rest   silence;
@

@Action
spk0.wave  spk0.note  spk0.delay;

# ---------- 前奏 ----------
